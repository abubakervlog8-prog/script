local function sendTopNotification(txt)
    local Banner = Instance.new("TextLabel")
    Banner.Size = UDim2.new(0, 360, 0, 40)
    Banner.Position = UDim2.new(0.5, -180, -0.1, 0)
    Banner.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    Banner.TextColor3 = Color3.fromRGB(0, 255, 150)
    Banner.Text = txt
    Banner.Font = Enum.Font.SourceSansBold
    Banner.TextSize = 14
    Banner.BorderSizePixel = 0
    Banner.ZIndex = 99999
    Banner.Parent = ScreenGui
    
    local str = Instance.new("UIStroke") str.Thickness = 1.5 str.Color = Color3.fromRGB(0, 255, 150) str.Parent = Banner
    local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(0, 6) cr.Parent = Banner
    
    Banner:TweenPosition(UDim2.new(0.5, -180, 0.05, 0), "Out", "Quad", 0.35, true)
    task.delay(4, function()
        if Banner then
            Banner:TweenPosition(UDim2.new(0.5, -180, -0.1, 0), "In", "Quad", 0.35, true, function()
                Banner:Destroy()
            end)
        end
    end)
end

UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

