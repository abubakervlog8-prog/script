    infJumpEnabled = not infJumpEnabled
    if infJumpEnabled then
        InfJumpBtn.Text = "UNINF JUMP"
        InfJumpBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
    else
        InfJumpBtn.Text = "INF JUMP"
        InfJumpBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    end
end)

StartBtn.Activated:Connect(function()
    if isRecording then return end
    recordedFrames = {}
    isRecording = true
    Title.Text = "STATUS: RECORDING..."
    StartBtn.Text = "RECORDING RUNNING"
    StartBtn.BackgroundColor3 = Color3.fromRGB(200, 130, 0)
    
    local connection
    connection = RunService.PostSimulation:Connect(function()
        if not isRecording then connection:Disconnect() return end
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then
            local hrp = character.HumanoidRootPart
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            
            local cf = hrp.CFrame
            local x = math.round(cf.X * 1000) / 1000
            local y = math.round(cf.Y * 1000) / 1000
            local z = math.round(cf.Z * 1000) / 1000
            local look = hrp.CFrame.LookVector
            local lx = math.round(look.X * 100) / 100
            local lz = math.round(look.Z * 100) / 100
            
            local isJumping = (humanoid.Jump or humanoid:GetState() == Enum.HumanoidStateType.Jumping) and 1 or 0
            local isMoving = (humanoid.MoveDirection.Magnitude > 0) and 1 or 0
            
            table.insert(recordedFrames, string.format("%f_%f_%f_%f_%f_%d_%d", x, y, z, lx, lz, isJumping, isMoving))
        end
    end)
end)

CopyBtn.Activated:Connect(function()
    if not isRecording then return end
    isRecording = false
    Title.Text = "RECORDER"
    StartBtn.Text = "START RECORD"
    StartBtn.BackgroundColor3 = Color3.fromRGB(34, 139, 34)
    
    local chunks = {}
    local temp = {}
    for i, frameData in ipairs(recordedFrames) do
        table.insert(temp, frameData)
        if #temp >= 150 or i == #recordedFrames then
            table.insert(chunks, table.concat(temp, "|"))
            temp = {}
        end
    end
    
    local scriptOutput = "local chunks = {}\n"
    for idx, dataChunk in ipairs(chunks) do
        scriptOutput = scriptOutput .. string.format("chunks[%d] = \"%s\"\n", idx, dataChunk)
    end
    
    scriptOutput = scriptOutput .. [[
local compressedData = table.concat(chunks, "|")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local data = {}
for segment in string.gmatch(compressedData, "[^|]+") do
    local parts = string.split(segment, "_")
    if #parts >= 7 then
        table.insert(data, {
            X = tonumber(parts[1]), Y = tonumber(parts[2]), Z = tonumber(parts[3]),
            LX = tonumber(parts[4]), LZ = tonumber(parts[5]),
            Jump = (parts[6] == "1"), Moving = (parts[7] == "1")
        })
    end
end

while true do
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then
        local hrp = character.HumanoidRootPart
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local animate = character:FindFirstChild("Animate")
        
        for i = 1, #data do
            RunService.PostSimulation:Wait()
            local frame = data[i]
            hrp.CFrame = CFrame.new(Vector3.new(frame.X, frame.Y, frame.Z), Vector3.new(frame.X + frame.LX, frame.Y, frame.Z + frame.LZ))
            
            if animate and frame.Moving then
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end
            if frame.Jump then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                humanoid.Jump = true
            else
                humanoid.Jump = false
            end
        end
    end
    task.wait(1)
end
]]

    if setclipboard then
        setclipboard(scriptOutput)
        sendTopNotification("execute script in executer from clipboard")
    else
        sendTopNotification("ERROR: Executor Lacks Clipboard Action")
    end
end)
